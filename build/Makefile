.PHONY : tests/test_seq.cpp.i

tests/test_seq.s: tests/test_seq.cpp.s
.PHONY : tests/test_seq.s

# target to generate assembly for a file
tests/test_seq.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_seq.dir/build.make CMakeFiles/test_seq.dir/tests/test_seq.cpp.s
.PHONY : tests/test_seq.cpp.s

